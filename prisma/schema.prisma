generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  username             String?              @unique
  password             String?
  image                String?
  emailVerified        DateTime?
  isActive             Boolean              @default(true)
  staffRoleId          String?
  staffRole            Role?                @relation(fields: [staffRoleId], references: [id])
  accounts             Account[]
  sessions             Session[]
  auditLogs            AuditLog[]
  carts                Cart[]
  addresses            Address[]
  orders               Order[]
  managedStore         Store?               @relation("StoreManager")
  storeAccess          StaffStoreAccess[]
  passwordResetTokens  PasswordResetToken[]
  heroSettingsUpdated  SiteSetting[]        @relation("HeroSettingsUpdatedBy")
  galleryImagesCreated GalleryImage[]       @relation("GalleryImageCreatedBy")
  sessionVersion       Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  systemKey   String?          @unique
  workspace   RoleWorkspace    @default(STAFF)
  isSystem    Boolean          @default(false)
  description String?
  permissions RolePermission[]
  staffUsers  User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum RoleWorkspace {
  CUSTOMER
  STAFF
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([guestId])
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  productType String
  name        String
  price       Decimal
  quantity    Int      @default(1)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cartId])
  @@index([productId, productType])
}

enum FoodKind {
  STANDARD
  COMBO
}

model Food {
  id                String                   @id @default(cuid())
  name              String
  slug              String                   @unique
  kind              FoodKind                 @default(STANDARD)
  basePrice         Decimal                  @default(0)
  discountPercent   Decimal                  @default(0)
  description       String?
  isAvailable       Boolean                  @default(true)
  imageUrl          String?
  imageDeleteUrl    String?
  categories        FoodCategoryAssignment[]
  tags              FoodTagAssignment[]
  bundleItems       FoodBundleItem[]         @relation("BundleFood")
  componentOf       FoodBundleItem[]         @relation("ComponentFood")
  storeAvailability FoodStoreAvailability[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([kind, isAvailable])
  @@index([createdAt])
}

model FoodCategory {
  id        String                   @id @default(cuid())
  name      String                   @unique
  slug      String                   @unique
  foods     FoodCategoryAssignment[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

model FoodTag {
  id        String              @id @default(cuid())
  name      String              @unique
  slug      String              @unique
  foods     FoodTagAssignment[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model FoodCategoryAssignment {
  foodId     String
  categoryId String
  food       Food         @relation(fields: [foodId], references: [id], onDelete: Cascade)
  category   FoodCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([foodId, categoryId])
  @@index([categoryId, foodId])
}

model FoodTagAssignment {
  foodId String
  tagId  String
  food   Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  tag    FoodTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([foodId, tagId])
  @@index([tagId, foodId])
}

model FoodBundleItem {
  bundleFoodId    String
  componentFoodId String
  quantity        Int    @default(1)
  bundleFood      Food   @relation("BundleFood", fields: [bundleFoodId], references: [id], onDelete: Cascade)
  componentFood   Food   @relation("ComponentFood", fields: [componentFoodId], references: [id], onDelete: Restrict)

  @@id([bundleFoodId, componentFoodId])
  @@index([componentFoodId])
}

model FoodStoreAvailability {
  foodId      String
  storeId     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  food        Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([foodId, storeId])
  @@index([storeId, foodId])
}

model Store {
  id               String                  @id @default(cuid())
  name             String
  phone            String
  address          String
  imageUrl         String?
  imageDeleteUrl   String?
  managerId        String?                 @unique
  manager          User?                   @relation("StoreManager", fields: [managerId], references: [id], onDelete: SetNull)
  staffAccess      StaffStoreAccess[]
  foodAvailability FoodStoreAvailability[]
  orders           Order[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  isOpen           Boolean                 @default(true)

  @@index([managerId])
  @@index([createdAt])
}

model StaffStoreAccess {
  userId    String
  storeId   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@index([userId, isPrimary])
}

model Address {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  postalCode String
  country    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model Order {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id])
  storeId        String?
  store          Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status         String      @default("pending")
  subtotal       Decimal
  deliveryFee    Decimal     @default(50)
  total          Decimal
  idempotencyKey String?     @unique
  paymentStatus  String      @default("pending")
  sslTxnId       String?     @unique
  sslAmount      Decimal?
  sslHash        String?
  paymentMethod  String?
  items          OrderItem[]
  paymentAttempts PaymentAttempt[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([storeId])
}

enum PaymentAttemptStatus {
  PENDING
  VALID
  FAILED
  CANCELLED
}

model PaymentAttempt {
  id           String               @id @default(cuid())
  orderId      String
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway      String               @default("sslcommerz")
  transactionId String               @unique
  validationId String?              @unique
  amount       Decimal
  status       PaymentAttemptStatus @default(PENDING)
  failureReason String?
  initiatedAt  DateTime             @default(now())
  validatedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([orderId, createdAt])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productType String
  name        String
  price       Decimal
  quantity    Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId, productType])
}

model SiteSetting {
  id                 String   @id @default("global")
  heroImageUrl       String?
  heroImageAlt       String   @default("Delicious street food spread")
  heroImageDeleteUrl String?
  updatedById        String?
  updatedBy          User?    @relation("HeroSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([updatedById])
}

model GalleryImage {
  id             String   @id @default(cuid())
  imageUrl       String
  alt            String
  imageDeleteUrl String?
  createdById    String?
  createdBy      User?    @relation("GalleryImageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdById])
  @@index([createdAt])
}
